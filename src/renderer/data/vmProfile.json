{
  "name": "Helix Sandbox (planned)",
  "description": "Sandbox integration is coming soon. The preview and actions are mocked until VM wiring is implemented.",
  "capabilities": [
    "browser",
    "shell",
    "files"
  ],
  "controlSchema": {
    "version": "0.1",
    "tools": {
      "browser": {
        "actions": [
          "open_url",
          "click",
          "type",
          "scroll",
          "screenshot"
        ],
        "payload": {
          "selector": "string",
          "text": "string",
          "url": "string",
          "direction": "up|down",
          "amount": "number"
        }
      },
      "shell": {
        "actions": [
          "run_command",
          "write_file",
          "read_file"
        ],
        "payload": {
          "command": "string",
          "path": "string",
          "contents": "string"
        }
      },
      "files": {
        "actions": [
          "list",
          "upload",
          "download",
          "move",
          "delete"
        ],
        "payload": {
          "path": "string",
          "destination": "string"
        }
      }
    }
  },
  "guardrails": [
    "Read-only actions are executed automatically.",
    "Write, destructive, or external actions require explicit user confirmation.",
    "Sensitive inputs must be entered during Take Over mode.",
    "Sandbox preview is mocked until VM integration is implemented.",
    "Never access host files outside the sandbox without explicit permission."
  ]
}
